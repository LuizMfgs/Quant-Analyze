# ─────────────────────────────────────────────────────────────
# quant-portfolio — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it's gitignored, and a leaked service key
# bypasses all Row-Level Security.
# ─────────────────────────────────────────────────────────────

# ── Supabase: database connection (required) ────────────────
# Supabase Dashboard → Project Settings → Database →
#   Connection string → URI
#
# Use the CONNECTION POOLER (port 6543) for application traffic.
# Use port 5432 only when running DDL (sql/001_schema.sql).
#
# Format:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Supabase: API credentials (required for Storage / model artifacts) ──
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — full admin access, bypasses RLS.
# Treat it like a database password.
SUPABASE_SERVICE_KEY=

# ── Optional: dashboard auth (only when you add Supabase Auth) ──
# Safe-ish for client-side use; respects RLS.
# SUPABASE_ANON_KEY=