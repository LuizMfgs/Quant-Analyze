# ─────────────────────────────────────────────────────────────
# quant-portfolio — environment variables (AWS edition)
# Copy to .env and fill in. NEVER commit .env.
#
# Note: on ECS the task definition injects DATABASE_URL from SSM
# and S3_BUCKET / AWS_REGION as plain env vars, with permissions
# coming from the IAM task role — no access keys exist there.
# This file is for LOCAL development only.
# ─────────────────────────────────────────────────────────────

# ── RDS Postgres (required) ────────────────────────────────
# From phase1.sh output. Direct endpoint, port 5432 — no pooler needed.
# DATABASE_URL=postgresql://quantapp:<password>@quant-portfolio.xxx.us-east-1.rds.amazonaws.com:5432/quant
DATABASE_URL=

# ── AWS credentials (required locally; NOT used on ECS) ────
# Access keys for the quant-pipeline IAM user created by phase1.sh.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── S3 (required) ──────────────────────────────────────────
# Bucket name printed by phase1.sh, e.g. quant-artifacts-123456789012
S3_BUCKET=